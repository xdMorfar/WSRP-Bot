{
  "name": "wisconsin-state-roleplay-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Production-oriented Discord management bot for Wisconsin State Roleplay (ER:LC)",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "deploy:commands": "tsx src/deploy-commands.ts"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "16.6.1",
    "mongoose": "9.10.3",
    "ms": "2.1.3"
  },
  "devDependencies": {
    "@types/ms": "2.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "@types/node": "^24.0.0"
  }
}
