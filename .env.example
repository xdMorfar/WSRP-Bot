# Discord application / bot credentials
DISCORD_TOKEN=replace_me
DISCORD_CLIENT_ID=replace_me
# Optional: register commands instantly in one development/production guild.
# Leave blank to register globally (global updates can take longer to appear).
DISCORD_GUILD_ID=

# MongoDB Atlas or compatible MongoDB connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/wisconsin_state_roleplay?retryWrites=true&w=majority

# Set to true on first deploy or whenever slash command definitions change.
REGISTER_COMMANDS=true

# Optional bootstrap users allowed to run /setup before an admin role has been configured.
# The Discord server owner is always allowed. Comma-separated user IDs.
BOOTSTRAP_ADMIN_IDS=

# Logging
LOG_LEVEL=info

# Optional ER:LC API key. Core bot functionality does not require this.
# No ER:LC API endpoints are called by this release unless a supported integration is added.
ERLC_API_KEY=
